{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "main": ".open-next/worker.js",
    "name": "01x-app",
    "compatibility_date": "2026-01-15",
    "compatibility_flags": [
        "nodejs_compat"
    ],
    "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
    },
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "01x-db",
            "database_id": "1b6b2a95-757b-443e-87f9-0b8a9c9610ec",
            "migrations_dir": "db/migrations"
        }
    ],
    "observability": {
        "logs": {
            "enabled": true,
            "invocation_logs": true
        }
    }
}